{
  "name": "@movejs/cli",
  "version": "0.1.0",
  "description": "MoveJS CLI - Project scaffolding, dev server, build, and deployment tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "movejs": "./dist/cli.js",
    "create-movejs": "./dist/create.js"
  },
  "files": ["dist", "assets"],
  "scripts": {
    "build": "tsup src/cli.ts src/create.ts --format esm --dts",
    "dev": "tsup src/cli.ts src/create.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0",
    "execa": "^8.0.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0"
  },
  "license": "MIT"
}
